{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "jsx": "react" /* Meteor's classic bundler uses the classic JSX runtime */,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "paths": {
      /* Absolute /imports/... paths, like Meteor resolves them */
      "/*": ["./*"],
      /* Meteor package types: zodern:types writes .meteor/local/types once the app has run */
      "meteor/*": ["./node_modules/@types/meteor/*", "./.meteor/local/types/packages.d.ts"]
    }
  },
  "exclude": ["./.meteor/**", "./node_modules/**"]
}
