{
  "name": "meteor-rpc",
  "version": "2.0.0-alpha.0",
  "description": "End-to-end type-safe RPC (methods and publications) for Meteor, with optional React and TanStack Query hooks.",
  "license": "MIT",
  "author": "Gabriel Grubba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grubba27/meteor-rpc.git"
  },
  "homepage": "https://github.com/Grubba27/meteor-rpc#readme",
  "bugs": "https://github.com/Grubba27/meteor-rpc/issues",
  "keywords": [
    "meteor",
    "rpc",
    "typescript",
    "react",
    "tanstack-query",
    "react-query",
    "standard-schema",
    "zod",
    "valibot",
    "arktype"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/server/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/esm/client/index.d.ts",
        "default": "./dist/esm/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react/index.d.ts",
        "default": "./dist/esm/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server/index.d.ts"
      ],
      "client": [
        "./dist/client/index.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "bin": {
    "meteor-rpc-migrate": "./dist/codemod/cli.js"
  },
  "files": [
    "dist",
    "server",
    "client",
    "react",
    "skills",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/mark-esm.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "test:consumer": "node scripts/consumer-check.mjs",
    "test:docs": "node scripts/docs-snippets.mjs",
    "test:meteor": "node scripts/meteor-test.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:types && npm run build && npm run test:consumer && npm run test:docs -- --skip-build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tanstack/react-query": "5.104.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "arktype": "2.2.8",
    "jsdom": "30.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "valibot": "1.5.0",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zod3": "npm:zod@3.24.0"
  }
}
